--=========== AURA LOOP ===========
local lastHit, busy = 0, false

local function hitPass()
    local _, myR = alive(LP)
    if not myR then return end
    local mode = S.Targets:lower():gsub("%s", "")

    local found = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and not matches(S.Safe, p.Name) then
            if mode == "all" or mode == "" or matches(S.Targets, p.Name) then
                local h, r = alive(p)
                if h and r then
                    local d = (r.Position - myR.Position).Magnitude
                    if d <= S.Range then
                        table.insert(found, { h = h, r = r, d = d })
                    end
                end
            end
        end
    end
    if #found == 0 then return end
    table.sort(found, function(a, b) return a.d < b.d end)

    local count = S.Multi and math.min(#found, 12) or 1
    for i = 1, count do
        local t = found[i]
        local pos = t.r.Position + t.r.CFrame.LookVector * 2
        for _ = 1, math.max(S.Damage, 1) do
            pcall(function() HitRF:InvokeServer(t.h, pos) end)
        end
    end
end

conn(RunService.Heartbeat, function()
    if not S.Aura or not HitRF or busy then return end
    if os.clock() - lastHit < 1 / math.max(S.APS, 1) then return end
    lastHit = os.clock()
    busy = true
    task.spawn(function()
        pcall(hitPass)
        busy = false
    end)
end)

