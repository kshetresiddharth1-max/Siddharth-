local HitRF

local function findHit()
    local ok, rf = pcall(function()
        return RS.Packages.Knit.Services.CombatService.RF
    end)
    if ok and rf then
        local h = rf:FindFirstChild("Hit")
        if h and h:IsA("RemoteFunction") then HitRF = h return true end
    end
    for _, v in ipairs(RS:GetDescendants()) do
        if v:IsA("RemoteFunction") and v.Name == "Hit" then
            HitRF = v
            return true
        end
    end
    return false
end

