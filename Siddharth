--=========== AURA LOOP ===========
local lastHit = 0
conn(RunService.Heartbeat, function()
    if not S.Aura or not HitRF then return end
    if os.clock() - lastHit < 1 / math.max(S.APS, 1) then return end
    local _, myR = alive(LP)
    if not myR then return end

    local best, bestD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and not matches(S.Safe, p.Name) then
            local mode = S.Targets:lower():gsub("%s", "")
            if mode == "all" or mode == "" or matches(S.Targets, p.Name) then
                local h, r = alive(p)
                if h and r then
                    local d = (r.Position - myR.Position).Magnitude
                    if d <= S.Range and d < bestD then
                        best, bestD = { h = h, r = r }, d
                    end
                end
            end
        end
    end

    if best then
        lastHit = os.clock()
        local pos = best.r.Position + best.r.CFrame.LookVector * 2
        pcall(function() HitRF:InvokeServer(best.h, pos) end)
    end
end)

