--  UNLOCK
--=============================================================
local unlocked = false
local built = false

unlock = function(silent)
	if unlocked then return end

	local cleaned = tostring(enteredKey or ""):gsub("%s+", ""):upper()

	if cleaned == "" then
		if not silent then
			notify("HUS HUB", "Pehle key daalo, phir Enter dabao.", 3)
		end
		return
	end

	if cleaned ~= KEY then
		if not silent then
			notify("Wrong Key", "Key galat hai.", 4)
		end
		return
	end

	unlocked = true
	saveKey()
	pcall(function()
		statusText:Set({
			Title = "Key Accepted",
			Content = "Key save ho gayi. Next execute pe khud khulega.",
		})
	end)

	if built then return end
	built = true

	task.wait(0.1)

	local ok, err = pcall(BuildHub)
	if not ok then
		print("HUS HUB ERROR: " .. tostring(err))
		notify("HUS HUB Error", tostring(err), 15)
	end
end

