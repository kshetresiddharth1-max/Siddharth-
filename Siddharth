local flyBV, flyBG
local function stopFly()
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyBG then flyBG:Destroy(); flyBG = nil end
    local h = myHum()
    if h then h.PlatformStand = false end
end
local function startFly()
    local h, r = alive(LP)
    if not h or not r then return end
    h.PlatformStand = true
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = r
    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    flyBG.P = 1000
    flyBG.Parent = r
end

Move:CreateToggle({
    Name = "Fly (Space up / Ctrl down)",
    CurrentValue = false,
    Flag = "FlyOn",
    Callback = function(v)
        S.Fly = v
        if v then startFly() else stopFly() end
    end,
})

conn(RunService.RenderStepped, function()
    if not S.Fly then return end
    local h, r = alive(LP)
    if not h or not r then return end
    if not flyBV then startFly() return end
    local cam = workspace.CurrentCamera
    local dir = Vector3.zero
    if h.MoveDirection.Magnitude > 0 then dir += h.MoveDirection end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir += Vector3.new(0, -1, 0) end
    flyBV.Velocity = dir.Magnitude > 0 and (cam.CFrame.Rotation * dir.Unit) * 60 or Vector3.zero
    flyBG.CFrame = cam.CFrame.Rotation
end)

