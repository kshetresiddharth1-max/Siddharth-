	local function faceTarget(hrp)
		local root = getRoot()
		if not root or not hrp then return end
		local look = Vector3.new(hrp.Position.X, root.Position.Y, hrp.Position.Z)
		if stickTarget then
			local dir = root.Position - look
			if dir.Magnitude < 1 then dir = Vector3.new(0, 0, 1) end
			root.CFrame = CFrame.new(look + dir.Unit * 3.5, look)
		else
			root.CFrame = CFrame.new(root.Position, look)
		end
	end

	local function ensureHook()
		if not hookmetamethod or not getnamecallmethod then return false end
		if ensureHook.done then return true end
		ensureHook.done = true

		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
			if capturing and not firingSelf then
				local method = getnamecallmethod()
				if method == "FireServer" or method == "InvokeServer" then
					if typeof(self) == "Instance" and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
						local args = table.pack(...)
						local targetChar
						for i = 1, args.n do
							local a = args[i]
							if typeof(a) == "Instance" then
								local cand
								if a:IsA("Humanoid") then
									cand = a.Parent
								elseif a:IsA("BasePart") then
									cand = a.Parent
								elseif a:IsA("Model") then
									cand = a
								end
								if cand and cand ~= LocalPlayer.Character and cand:FindFirstChildOfClass("Humanoid") then
									targetChar = cand
									break
								end
							end
						end
						capRemote = self
						capArgs = args
						capTargetChar = targetChar
						capturing = false
						notify("Capture", "Remote pakda: " .. self.Name, 6)
					end
				end
			end
			return oldNamecall(self, ...)
		end)
		return true
	end

	local function buildArgs(newChar, newHum, newHrp)
		local args = {}
		if not capArgs then return args end
		for i = 1, capArgs.n do
			local a = capArgs[i]
			if typeof(a) == "Instance" then
				if a:IsA("Humanoid") then
					a = newHum
				elseif capTargetChar and a == capTargetChar then
					a = newChar
				elseif a:IsA("BasePart") then
					a = newHrp
				elseif a:IsA("Model") then
					a = newChar
				end
			end
			args[i] = a
		end
		return args
	end

	local function equipTool()
		local char = LocalPlayer.Character
		if not char then return end
		if char:FindFirstChildOfClass("Tool") then return end
		local bp = LocalPlayer:FindFirstChild("Backpack")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not bp or not hum then return end
		for _, item in ipairs(bp:GetChildren()) do
			if item:IsA("Tool") then
				pcall(function() hum:EquipTool(item) end)
				return
			end
		end
	end

	local function fireCaptured(t)
		if not capRemote or not capArgs then return false end
		local args = buildArgs(t.char, t.hum, t.hrp)
		firingSelf = true
		pcall(function()
			if capRemote:IsA("RemoteEvent") then
				capRemote:FireServer(table.unpack(args, 1, capArgs.n))
			else
				capRemote:InvokeServer(table.unpack(args, 1, capArgs.n))
			end
		end)
		firingSelf = false
		return true
	end

	local function scanRemotes()
		hitRemotes = {}
		local keywords = { "hit", "attack", "punch", "damage", "kick", "slash", "swing", "combat", "fight" }
		for _, obj in ipairs(game:GetDescendants()) do
			if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
				local n = obj.Name:lower()
				for _, k in ipairs(keywords) do
					if n:find(k) then
						table.insert(hitRemotes, obj)
						break
					end
				end
			end
		end
		return #hitRemotes
	end

	local function getTargets()
		local list = {}
		local root = getRoot()
		if not root then return list end

		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then
				local hum = p.Character:FindFirstChildOfClass("Humanoid")
				local hrp = p.Character:FindFirstChild("HumanoidRootPart")
				if hum and hrp and hum.Health > 0 and (hrp.Position - root.Position).Magnitude <= auraRange then
					table.insert(list, { char = p.Character, hum = hum, hrp = hrp })
				end
			end
		end

		if includeNPCs then
			for _, m in ipairs(workspace:GetChildren()) do
				if m:IsA("Model") and m ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(m) then
					local hum = m:FindFirstChildOfClass("Humanoid")
					local hrp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
					if hum and hrp and hum.Health > 0 and (hrp.Position - root.Position).Magnitude <= auraRange then
						table.insert(list, { char = m, hum = hum, hrp = hrp })
					end
				end
			end
		end

		return list
	end

	local function attackTarget(t)
		faceTarget(t.hrp)
		if autoEquip then equipTool() end

		if fireCaptured(t) then return end

		local char = LocalPlayer.Character
		if not char then return end
		local tool = char:FindFirstChildOfClass("Tool")
		if tool then pcall(function() tool:Activate() end) end

		for _, r in ipairs(hitRemotes) do
			pcall(function()
				if r:IsA("RemoteEvent") then
					r:FireServer(t.hum, t.char, t.hrp)
					r:FireServer(t.char)
					r:FireServer(t.hrp)
				else
					r:InvokeServer(t.hum, t.char)
				end
			end)
		end

		for _, d in ipairs(t.char:GetDescendants()) do
			if d:IsA("ProximityPrompt") and d.Enabled then
				pcall(function()
					if fireproximityprompt then
						fireproximityprompt(d, 0)
					else
						d:InputHoldBegin()
						d:InputHoldEnd()
					end
				end)
			end
		end
	end

