--=========== BANG MATH ===========
local OFFSETS = {
    ["Normal Bang"] = function(tcf, hcf, th, d)
        return tcf * CFrame.new(0, 0, d) * CFrame.Angles(0, math.pi, 0)
    end,
    ["Mouth Bang"] = function(tcf, hcf, th, d)
        return hcf * CFrame.new(0, 0, d * 0.5) * CFrame.Angles(0, math.pi, 0)
    end,
    ["Pussy Bang"] = function(tcf, hcf, th, d)
        return tcf * CFrame.new(0, -1.2, d * 0.5) * CFrame.Angles(0, math.pi, 0)
    end,
    ["Back Bang"] = function(tcf, hcf, th, d)
        return tcf * CFrame.new(0, 0, -d)
    end,
    ["Side Bang"] = function(tcf, hcf, th, d)
        return tcf * CFrame.new(d, 0, 0) * CFrame.Angles(0, math.pi / 2, 0)
    end,
    ["Head Sit Bang"] = function(tcf, hcf, th, d)
        return hcf * CFrame.new(0, 1.3, 0) * CFrame.Angles(0, math.pi, 0)
    end,
    ["Sit Bang"] = function(tcf, hcf, th, d)
        return tcf * CFrame.new(0, 0, d * 0.8) * CFrame.Angles(0, math.pi, 0)
    end,
    ["Orbit Bang"] = function(tcf, hcf, th, d)
        local pos = (tcf * CFrame.new(math.sin(th) * d, 0, math.cos(th) * d)).Position
        return CFrame.lookAt(pos, tcf.Position)
    end,
    ["Vertical Orbit Bang"] = function(tcf, hcf, th, d)
        local pos = (tcf * CFrame.new(0, math.sin(th) * d, math.cos(th) * d)).Position
        return CFrame.lookAt(pos, tcf.Position)
    end,
    ["Circle Bang"] = function(tcf, hcf, th, d)
        return tcf * CFrame.new(math.sin(th) * d, 0, math.cos(th) * d)
    end,
    ["Figure 8 Bang"] = function(tcf, hcf, th, d)
        local pos = (tcf * CFrame.new(math.sin(th) * d, math.sin(th * 2) * d * 0.6, math.cos(th) * d)).Position
        return CFrame.lookAt(pos, tcf.Position)
    end,
    ["Spin Bang"] = function(tcf, hcf, th, d)
        return tcf * CFrame.new(0, 0, d) * CFrame.Angles(0, math.pi + th, 0)
    end,
    ["Upside Down Bang"] = function(tcf, hcf, th, d)
        return tcf * CFrame.new(0, d, 0) * CFrame.Angles(math.pi, 0, 0)
    end,
    ["Sky Bang"] = function(tcf, hcf, th, d)
        return tcf * CFrame.new(0, d * 2.5, 0)
    end,
    ["Far Bang"] = function(tcf, hcf, th, d)
        return tcf * CFrame.new(0, 0, d * 2.5) * CFrame.Angles(0, math.pi, 0)
    end,
    ["Random Bang"] = function(tcf, hcf, th, d)
        local pos = (tcf * CFrame.new((math.random() - 0.5) * d * 2, (math.random() - 0.5) * d * 2, (math.random() - 0.5) * d * 2)).Position
        return CFrame.lookAt(pos, tcf.Position)
    end,
}

local ATTACH = {
    ["Attach Bang"] = true,
}

--=========== BANG CONTROL ===========
local bangTheta, bangLast, attachOffset = 0, 0, nil

local function stopBang(silent)
    if S.Bang then
        S.Bang = nil
        attachOffset = nil
        local h = myHum()
        if h then h.PlatformStand = false end
        if not silent then
            Rayfield:Notify({ Title = "Bang stopped", Content = "", Duration = 2, Image = 4483362458 })
        end
    end
end

local function startBang(name)
    local h, r = alive(LP)
    if not h or not r then return end
    if S.Fly then stopFly() S.Fly = false end
    h.PlatformStand = true
    bangTheta = 0
    bangLast = os.clock()
    attachOffset = nil
    S.Bang = name
    if ATTACH[name] then
        local _, tr = resolveTarget()
        if tr then attachOffset = tr.CFrame:ToObjectSpace(r.CFrame) end
    end
end

function resolveTarget()
    local want = (S.BangTarget or ""):lower():gsub("^%s*(.-)%s*$", "%1")
    if want ~= "" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Name:lower():find(want, 1, true) then
                local h, r = alive(p)
                if h then return p, h, r end
            end
        end
        return nil
    end
    local _, myR = alive(LP)
    if not myR then return nil end
    local best, bd
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local h, r = alive(p)
            if h then
                local d = (r.Position - myR.Position).Magnitude
                if not bd or d < bd then best, bd = p, d end
            end
        end
    end
    if best then
        local h, r = alive(best)
        return best, h, r
    end
    return nil
end

conn(RunService.Heartbeat, function()
    if not S.Bang then return end
    local h, r = alive(LP)
    if not h or not r then return end
    local _, _, tr = resolveTarget()
    if not tr then return end

    local now = os.clock()
    local dt = now - bangLast
    bangLast = now
    bangTheta += dt * (S.BangSpeed * 0.1)

    local thcf = tr.CFrame
    local head = tr.Parent and tr.Parent:FindFirstChild("Head")
    local hcf = head and head.CFrame or thcf

    local cf
    if ATTACH[S.Bang] then
        if not attachOffset then attachOffset = thcf:ToObjectSpace(r.CFrame) end
        cf = thcf * attachOffset
    else
        local fn = OFFSETS[S.Bang]
        if not fn then return end
        local ok, res = pcall(fn, thcf, hcf, bangTheta, S.BangDist)
        if ok then cf = res end
    end

    if cf then
        r.CFrame = cf
        r.AssemblyLinearVelocity = Vector3.zero
    end
end)

