local _PAD = "huskey"
local _BLOB = "65,65,65,122,118,108,127"

local function bxor(a, b)
	if bit32 and bit32.bxor then
		return bit32.bxor(a, b)
	end
	local r, bit = 0, 1
	while a > 0 or b > 0 do
		local ab = a % 2
		local bb = b % 2
		if ab ~= bb then r += bit end
		a = math.floor(a / 2)
		b = math.floor(b / 2)
		bit *= 2
	end
	return r
end

local function decodeSecret()
	local chars = {}
	local idx = 0
	for num in _BLOB:gmatch("%d+") do
		idx += 1
		local raw = tonumber(num) - 33
		local p = _PAD:byte((idx - 1) % #_PAD + 1)
		chars[idx] = string.char(bxor(raw, p))
	end
	return table.concat(chars)
end

local KEY = decodeSecret()

